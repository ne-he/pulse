# ── Copy to .env and fill what you need. Walking skeleton runs with ZERO secrets. ──

# Redis Streams bus (docker-compose provides this host automatically).
# Use memory:// to run the whole loop in one process with no Redis server at all,
# which is what `python -m deploy.demo` does. Needs the optional fakeredis package.
REDIS_URL=redis://redis:6379/0

# Ingestion mode:
#   replay  -> stream historical/synthetic data as if live (DEMO MODE, no internet needed)
#   live    -> poll OpenAQ + weather API for real Jakarta data
INGEST_MODE=replay
POLL_INTERVAL_SEC=60          # live mode: how often producer polls the API
REPLAY_SPEED=600            # replay mode: 1 real second = REPLAY_SPEED simulated seconds (~1 frame/sec)

# OpenAQ (live mode). v3 needs a free API key from https://explore.openaq.org/
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
# Open-Meteo weather is keyless:
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Online model
MODEL_KIND=river             # river | baseline  (baseline = last-value, walking-skeleton safe)
FORECAST_HORIZON=6           # how many steps ahead to forecast
UNCERTAINTY_Z=1.96          # z for the shaded interval (1.96 ≈ 95%)

# Anomaly detector (one-step forecast surprise, robust z-score)
ANOMALY_THRESHOLD=0.85       # score = z/(1+z), so 0.85 means z >= 5.67 sigmas
ANOMALY_WARMUP=30            # events before the detector is allowed to alarm
ANOMALY_AQI_FLOOR=51         # ignore anomalies in Good air (US AQI < 51); 0 disables
ANOMALY_WINDOW=300           # residuals kept for the robust spread estimate

# Drift / retrain
DRIFT_WINDOW=200             # observations per drift window
DRIFT_THRESHOLD=0.5         # share of drifted features that triggers retrain
# psi | evidently. Explicit on purpose: this used to be "try evidently, fall back to
# psi", which made the detector depend on whether the import happened to work here.
# psi is the default because it measured better at DRIFT_WINDOW=200. The comparison
# is in the module docstring of ml/monitoring/drift.py.
DRIFT_ENGINE=psi

# Agent (incident cards). Leave blank -> deterministic template fallback (still works!)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local model registry (swap for Supabase later — see ml/registry/registry.py)
REGISTRY_PATH=/data/registry

# API
API_PORT=8000
